# Local-only settings. Copy to .env and set OSHA_DATABASE_PASSWORD.
# These are local OSHA model artifacts; no third-party model API key is used.

# Database
OSHA_DATABASE_BACKEND=postgresql
OSHA_DATABASE_NAME=osha
OSHA_DATABASE_ENVIRONMENT_ID=kubernetes
OSHA_DATABASE_HOST=postgres
OSHA_DATABASE_PORT=5432
OSHA_DATABASE_USERNAME=osha
OSHA_DATABASE_SECRET_PROVIDER=environment
OSHA_DATABASE_SECRET_NAME=database-password
OSHA_DATABASE_SECRET_KEY=OSHA_DATABASE_PASSWORD
OSHA_DATABASE_PASSWORD=

# Model family enablement
OSHA_AI_ENABLED=true
OSHA_AI_ALLOWED_FAMILIES=event,anomaly,incident_root_cause,decision_policy_risk,remediation_recommendation,capacity_forecasting
OSHA_MODEL_FAMILIES_ENABLED=true
OSHA_EVENT_MODEL_ENABLED=true
OSHA_ANOMALY_MODEL_ENABLED=true
OSHA_INCIDENT_ROOT_CAUSE_MODEL_ENABLED=true
OSHA_DECISION_RISK_MODEL_ENABLED=true
OSHA_REMEDIATION_RANKING_MODEL_ENABLED=true
OSHA_CAPACITY_FORECASTING_MODEL_ENABLED=true

# Model paths and device
OSHA_AI_MODELS_DIRECTORY=/app/models
OSHA_AI_CACHE_DIRECTORY=/app/artifacts/ai-cache
OSHA_AI_LOG_DIRECTORY=/app/logs/ai
OSHA_AI_DEVICE=auto
OSHA_AI_DEVICE_INDEX=
OSHA_AI_ALLOW_CPU_FALLBACK=true
OSHA_AI_MIXED_PRECISION=false
OSHA_ACCELERATOR=auto
OSHA_ALLOW_CPU_FALLBACK=true

# Model loading and integrity
OSHA_AI_LAZY_LOADING=true
OSHA_AI_VERIFY_CHECKSUM=true
OSHA_AI_MAXIMUM_LOADED_MODELS=4
OSHA_AI_UNLOAD_UNUSED_MODELS=true
OSHA_AI_ALLOW_RUNTIME_REPLACEMENT=false
OSHA_AI_REQUIRE_PROMOTED_STATE=true

# Inference limits
OSHA_AI_MAXIMUM_BATCH_SIZE=64
OSHA_AI_MAXIMUM_PAYLOAD_BYTES=4194304
OSHA_AI_TIMEOUT_SECONDS=30
OSHA_AI_ENABLE_BATCH_INFERENCE=true
OSHA_AI_REJECT_NON_FINITE_INPUTS=true
OSHA_AI_INCLUDE_REPRESENTATIONS=false

# Event model inference
OSHA_AI_EVENT_MAX_LENGTH=128
OSHA_AI_EVENT_TOP_K=1
OSHA_AI_EVENT_RETURN_SOURCE=true
OSHA_AI_EVENT_RETURN_COMPONENT=true
OSHA_AI_EVENT_RETURN_EVENT=true

# Anomaly model inference
OSHA_AI_ANOMALY_DEFAULT_THRESHOLD=0.50
OSHA_AI_ANOMALY_MINIMUM_THRESHOLD=0.0
OSHA_AI_ANOMALY_MAXIMUM_THRESHOLD=1.0
OSHA_AI_ANOMALY_ALLOW_THRESHOLD_OVERRIDE=false

# Model routing
OSHA_AI_USE_LATEST_VERSION=true
OSHA_AI_REQUIRE_EXPLICIT_FAMILY=true
OSHA_AI_ALLOW_FALLBACK_MODEL=false
OSHA_AI_FALLBACK_EVENT_MODEL=
OSHA_AI_FALLBACK_ANOMALY_MODEL=

# Capacity forecasting baseline
OSHA_FORECASTING_ENABLED=true
OSHA_FORECASTING_MINIMUM_POINTS=4
OSHA_FORECASTING_TRAINING_WINDOW_HOURS=24
OSHA_FORECASTING_DEFAULT_HORIZON_HOURS=12
OSHA_FORECASTING_STEP_MINUTES=60