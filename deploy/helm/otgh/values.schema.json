{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "OTGH Helm Chart Values",
  "description": "Validation schema for the OTGH Helm chart configuration.",
  "type": "object",
  "additionalProperties": false,

  "properties": {
    "nameOverride": {
      "type": "string",
      "maxLength": 63,
      "default": ""
    },

    "fullnameOverride": {
      "type": "string",
      "maxLength": 63,
      "default": ""
    },

    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations"],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[-a-z0-9]*[a-z0-9]?$"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },

    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port"],
      "properties": {
        "type": {
          "type": "string",
          "const": "ClusterIP"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },

    "osha": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint"],
      "properties": {
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https?://"
        }
      }
    },

    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },

    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },

    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },

    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Recreate", "RollingUpdate"]
        }
      }
    },

    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },

    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1
    },

    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeID", "workers", "ingestAddress"],
      "properties": {
        "nodeID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "workers": {
          "type": "integer",
          "minimum": 1
        },
        "ingestAddress": {
          "type": "string",
          "minLength": 1
        }
      }
    },

    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create",
        "name",
        "annotations",
        "automountServiceAccountToken"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "maxLength": 63
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      }
    },

    "podAnnotations": {
      "$ref": "#/definitions/stringMap"
    },

    "podLabels": {
      "$ref": "#/definitions/stringMap"
    },

    "deploymentAnnotations": {
      "$ref": "#/definitions/stringMap"
    },

    "podSecurityContext": {
      "type": "object"
    },

    "securityContext": {
      "type": "object"
    },

    "resources": {
      "type": "object"
    },

    "command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },

    "extraVolumes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },

    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },

    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "annotations",
        "shutdownTimeout",
        "batching",
        "queue",
        "retry",
        "spool",
        "protocol",
        "exporters",
        "routes"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },

        "annotations": {
          "$ref": "#/definitions/stringMap"
        },

        "shutdownTimeout": {
          "type": "integer",
          "minimum": 1
        },

        "batching": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxRecords", "maxPayloadBytes"],
          "properties": {
            "maxRecords": {
              "type": "integer",
              "minimum": 1
            },
            "maxPayloadBytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },

        "queue": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capacity"],
          "properties": {
            "capacity": {
              "type": "integer",
              "minimum": 1
            }
          }
        },

        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxAttempts",
            "initialDelay",
            "maxDelay",
            "multiplier",
            "jitter",
            "maxElapsedTime"
          ],
          "properties": {
            "maxAttempts": {
              "type": "integer",
              "minimum": 1
            },
            "initialDelay": {
              "type": "integer",
              "minimum": 1
            },
            "maxDelay": {
              "type": "integer",
              "minimum": 1
            },
            "multiplier": {
              "type": "number",
              "minimum": 1
            },
            "jitter": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "maxElapsedTime": {
              "type": "integer",
              "minimum": 1
            }
          }
        },

        "spool": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "directory",
            "directoryMode",
            "fileMode",
            "maxEntries",
            "maxBytes",
            "maxEntryBytes",
            "syncDirectory"
          ],
          "properties": {
            "directory": {
              "type": "string",
              "minLength": 1
            },
            "directoryMode": {
              "type": "integer",
              "minimum": 0,
              "maximum": 511
            },
            "fileMode": {
              "type": "integer",
              "minimum": 0,
              "maximum": 511
            },
            "maxEntries": {
              "type": "integer",
              "minimum": 1
            },
            "maxBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maxEntryBytes": {
              "type": "integer",
              "minimum": 1
            },
            "syncDirectory": {
              "type": "boolean"
            }
          }
        },

        "protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxFrameSize",
            "maxPayloadSize",
            "maxBatchRecords",
            "gzipLevel",
            "capabilities",
            "requireCapabilities"
          ],
          "properties": {
            "maxFrameSize": {
              "type": "integer",
              "minimum": 1
            },
            "maxPayloadSize": {
              "type": "integer",
              "minimum": 1
            },
            "maxBatchRecords": {
              "type": "integer",
              "minimum": 1
            },
            "gzipLevel": {
              "type": "integer",
              "minimum": -2,
              "maximum": 9
            },
            "capabilities": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/definitions/protocolCapability"
              }
            },
            "requireCapabilities": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/definitions/protocolCapability"
              }
            }
          }
        },

        "exporters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["http", "grpc", "objectStore", "webhook"],
          "properties": {
            "http": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "grpc": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "objectStore": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "webhook": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },

        "routes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },

    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "existingClaim",
        "storageClass",
        "accessModes",
        "size",
        "ephemeralSizeLimit",
        "annotations"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string",
          "maxLength": 253
        },
        "storageClass": {
          "type": "string",
          "maxLength": 253
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "ReadWriteOnce",
              "ReadOnlyMany",
              "ReadWriteMany",
              "ReadWriteOncePod"
            ]
          }
        },
        "size": {
          "$ref": "#/definitions/resourceQuantity"
        },
        "ephemeralSizeLimit": {
          "$ref": "#/definitions/resourceQuantity"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },

    "persistenceEphemeralWarning": {
      "type": "boolean"
    },

    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create",
        "existingSecret",
        "annotations",
        "values"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string",
          "maxLength": 253
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "values": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "httpBearerToken",
            "httpAPIKey",
            "httpBasicUsername",
            "httpBasicPassword",
            "ingestToken",
            "oshaToken",
            "grpcBearerToken",
            "grpcAPIKey",
            "awsAccessKeyID",
            "awsSecretAccessKey",
            "awsSessionToken",
            "webhookBearerToken",
            "webhookBasicUsername",
            "webhookBasicPassword",
            "webhookSigningSecret",
            "webhookSigningKeyID",
            "kmsKeyID"
          ],
          "properties": {
            "httpBearerToken": {
              "type": "string"
            },
            "httpAPIKey": {
              "type": "string"
            },
            "httpBasicUsername": {
              "type": "string"
            },
            "httpBasicPassword": {
              "type": "string"
            },
            "ingestToken": {
              "type": "string"
            },
            "oshaToken": {
              "type": "string"
            },
            "grpcBearerToken": {
              "type": "string"
            },
            "grpcAPIKey": {
              "type": "string"
            },
            "awsAccessKeyID": {
              "type": "string"
            },
            "awsSecretAccessKey": {
              "type": "string"
            },
            "awsSessionToken": {
              "type": "string"
            },
            "webhookBearerToken": {
              "type": "string"
            },
            "webhookBasicUsername": {
              "type": "string"
            },
            "webhookBasicPassword": {
              "type": "string"
            },
            "webhookSigningSecret": {
              "type": "string"
            },
            "webhookSigningKeyID": {
              "type": "string"
            },
            "kmsKeyID": {
              "type": "string"
            }
          }
        }
      }
    },

    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "annotations",
        "ingress",
        "egress"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "rules"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "rules"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    },

    "tmp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "sizeLimit"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "sizeLimit": {
          "$ref": "#/definitions/resourceQuantity"
        }
      }
    },

    "livenessProbe": {
      "$ref": "#/definitions/probe"
    },

    "readinessProbe": {
      "$ref": "#/definitions/probe"
    },

    "startupProbe": {
      "$ref": "#/definitions/probe"
    },

    "nodeSelector": {
      "type": "object"
    },

    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },

    "affinity": {
      "type": "object"
    },

    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },

    "priorityClassName": {
      "type": "string"
    },

    "dnsPolicy": {
      "type": "string",
      "enum": [
        "",
        "ClusterFirst",
        "ClusterFirstWithHostNet",
        "Default",
        "None"
      ]
    },

    "dnsConfig": {
      "type": "object"
    }
  },

  "required": [
    "nameOverride",
    "fullnameOverride",
    "namespace",
    "service",
    "osha",
    "image",
    "imagePullSecrets",
    "replicaCount",
    "strategy",
    "revisionHistoryLimit",
    "terminationGracePeriodSeconds",
    "runtime",
    "serviceAccount",
    "podAnnotations",
    "podLabels",
    "podSecurityContext",
    "securityContext",
    "resources",
    "config",
    "persistence",
    "secrets",
    "networkPolicy",
    "tmp",
    "livenessProbe",
    "readinessProbe",
    "startupProbe",
    "nodeSelector",
    "tolerations",
    "affinity",
    "topologySpreadConstraints",
    "priorityClassName"
  ],

  "definitions": {
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },

    "resourceQuantity": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]+([.][0-9]+)?(m|Ki|Mi|Gi|Ti|Pi|Ei|k|K|M|G|T|P|E)?$"
    },

    "protocolCapability": {
      "type": "string",
      "enum": [
        "telemetry",
        "resource_state",
        "resource_relationships",
        "topology",
        "security",
        "anomaly_detection",
        "forecasting",
        "situations",
        "blast_radius",
        "decisions",
        "remediation_results",
        "acknowledgements",
        "partial_acknowledgement",
        "sequencing",
        "batching"
      ]
    },

    "probe": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },

  "allOf": [
    {
      "if": {
        "properties": {
          "secrets": {
            "properties": {
              "create": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "secrets": {
            "properties": {
              "existingSecret": {
                "maxLength": 0
              }
            }
          }
        }
      }
    },

    {
      "if": {
        "properties": {
          "persistence": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "replicaCount": {
            "maximum": 1
          }
        }
      }
    }
  ]
}
